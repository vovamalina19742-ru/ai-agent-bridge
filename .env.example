# Network & Server Configuration (Remote Linux Node - Optional)
REMOTE_HOST=192.168.1.100
REMOTE_USER=ubuntu
SERVER_MAC_PRIMARY=00:11:22:33:44:55
SERVER_MAC_SECONDARY=00:11:22:33:44:66

# Storage & Paths
BOOKS_DIR=./books
DATABASE_PATH=./books_index.db
QUEUE_DB_PATH=./bridge_queue.db

# Ollama Local LLM Settings
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=qwen2.5-coder:7b
EMBEDDING_MODEL=nomic-embed-text
